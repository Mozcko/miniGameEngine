#include "logic.h"

#include <stdio.h>

#define TEST_ASSERT(cond)                                                                                    \
    do {                                                                                                     \
        if (!(cond)) {                                                                                       \
            fprintf(stderr, "FALLO en %s:%d: %s\n", __FILE__, __LINE__, #cond);                              \
            return 1;                                                                                        \
        }                                                                                                    \
    } while (0)

static int test_sim_init(void) {
    SimState state;
    sim_logic_init(&state);
    TEST_ASSERT(state.stepCount == 0);
    TEST_ASSERT(state.accumulatedTime == 0.0f);
    return 0;
}

static int test_sim_stepping(void) {
    SimState state;
    sim_logic_init(&state);
    for (int i = 0; i < 60; ++i) {
        sim_logic_step(&state, 1.0f / 60.0f);
    }
    TEST_ASSERT(state.stepCount == 60);
    TEST_ASSERT(sim_logic_verify(&state, 60));
    return 0;
}

int main(void) {
    printf("Ejecutando tests de @GAME_NAME@ (C Headless)...\n");
    if (test_sim_init() != 0) return 1;
    if (test_sim_stepping() != 0) return 1;
    printf("Todos los tests de @GAME_NAME@ pasaron con exito.\n");
    return 0;
}
