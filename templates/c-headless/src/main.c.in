#include <mge/c/mge_c.h>
#include "logic.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct AppState {
    SimState sim;
} AppState;

static bool on_init(mge_app* app, void* user_data) {
    (void)app;
    AppState* state = (AppState*)user_data;
    sim_logic_init(&state->sim);
    printf("[@GAME_NAME@] Inicializando simulacion headless determinista\n");
    return true;
}

static void on_fixed_update(mge_app* app, float fixed_dt, void* user_data) {
    (void)app;
    (void)fixed_dt;
    (void)user_data;
}

static void on_update(mge_app* app, float dt, void* user_data) {
    (void)app;
    AppState* state = (AppState*)user_data;
    sim_logic_step(&state->sim, dt > 0.0f ? dt : (1.0f / 60.0f));
}

static void on_shutdown(mge_app* app, void* user_data) {
    (void)app;
    AppState* state = (AppState*)user_data;
    printf("[@GAME_NAME@] Simulacion finalizada con %lu pasos ejecutados\n",
           (unsigned long)state->sim.stepCount);
}

int main(int argc, char* argv[]) {
    (void)argc;
    (void)argv;

    int max_frames = 60;
    const char* env_frames = getenv("MGE_MAX_FRAMES");
    if (env_frames) {
        int parsed = atoi(env_frames);
        if (parsed > 0) {
            max_frames = parsed;
        }
    }

    mge_app_config config;
    memset(&config, 0, sizeof(config));
    config.struct_size = sizeof(mge_app_config);
    config.title = "@GAME_TITLE@";
    config.headless = true;
    config.max_frames = max_frames;
    config.tick_rate = 60;

    AppState state;
    memset(&state, 0, sizeof(state));

    mge_app_callbacks callbacks;
    callbacks.struct_size = sizeof(mge_app_callbacks);
    callbacks.on_init = on_init;
    callbacks.on_fixed_update = on_fixed_update;
    callbacks.on_update = on_update;
    callbacks.on_render = NULL;
    callbacks.on_shutdown = on_shutdown;
    callbacks.user_data = &state;

    int rc = mge_app_run(&config, &callbacks);
    if (rc != 0) {
        return rc;
    }

    if (!sim_logic_verify(&state.sim, (uint64_t)max_frames)) {
        fprintf(stderr, "Error: esperados %d pasos, obtenidos %lu\n", max_frames,
                (unsigned long)state.sim.stepCount);
        return 1;
    }

    return 0;
}
