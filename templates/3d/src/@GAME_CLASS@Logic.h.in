#pragma once

#include <mge/core/math/Geometry.h>
#include <mge/physics/GridQuery.h>

#include <glm/glm.hpp>

namespace @GAME_NAME@ {

    // Entity component that oscillates in the Fixed phase
    struct FloatingOrb {
        glm::vec3 basePosition{0.0f, 1.5f, 0.0f};
        float phase = 0.0f;
        float bobSpeed = 2.5f;
        float bobAmplitude = 0.4f;
        float rotationSpeed = 1.8f;
        float rotationAngle = 0.0f;
    };

    // Updates orb oscillation and rotation (deterministic)
    void updateFloatingOrb(FloatingOrb& orb, float dt);

    // Computes world position from the oscillation
    glm::vec3 computeOrbPosition(const FloatingOrb& orb);

    // Collision query function: flat floor at y < 0
    inline bool isFloorSolid(const glm::ivec3& block) {
        return block.y < 0;
    }

} // namespace @GAME_NAME@
