// @GAME_TITLE@: juego generado con scripts/new-game.sh (plantilla "window").
// Una ventana cuyo color de fondo late. Muestra: módulos, acciones de input, una entidad del ECS
// actualizada en el paso fijo, texto 2D, el overlay de rendimiento y el log. Esc sale, Espacio (mantener)
// acelera, F1 muestra FPS y tiempos.
#include <mge/mge.h> // API del motor (core + los módulos que enlaza este juego)

#include <algorithm>
#include <cmath>
#include <memory>

namespace {
    // Componente del ECS: fase de una oscilación
    struct Pulse {
        float phase = 0.0f;
        float speed = 1.0f; // radianes por segundo
    };

    class @GAME_CLASS@ : public mge::Application {
    public:
        @GAME_CLASS@() : mge::Application(makeConfig()) {
            addModule<mge::PlatformModule>(); // ventana e input
            addModule<mge::GpuModule>();      // GPU (Vulkan/Metal/D3D12): después de la plataforma
            addModule<mge::AudioModule>();
        }

    protected:
        bool onInit() override {
            m_platform = getModule<mge::PlatformModule>();
            m_gpu = getModule<mge::GpuModule>();
            m_platform->actions().bind("Quit", mge::Key::Escape);
            m_platform->actions().bind("Faster", mge::Key::Space);
            m_platform->actions().bind("Overlay", mge::Key::F1);

            // UI 2D en píxeles (texto con la fuente embebida: no hace falta ningún archivo)
            m_ui = std::make_unique<mge::Renderer2D>(m_gpu->device(), m_gpu->swapchainFormat());
            if (!m_ui->valid()) return false;

            // Una entidad con su componente, y un sistema que la avanza en cada paso fijo
            mge::Registry& registry = world().registry();
            m_pulse = registry.create();
            registry.add<Pulse>(m_pulse);
            world().addSystem(mge::SystemPhase::Fixed, "pulse", [](mge::World& w, float dt) {
                w.registry().each<Pulse>(
                    [dt](mge::Entity, Pulse& pulse) { pulse.phase += pulse.speed * dt; });
            });

            MGE_LOG_INFO("@GAME_NAME@", "Esc: salir, Espacio (mantener): más rápido, F1: rendimiento");
            return true;
        }

        // Los recursos de la GPU se liberan antes que el device (el GpuModule se cierra después del juego)
        void onShutdown() override { m_ui.reset(); }

        void onUpdate(float /*dt*/) override {
            if (m_platform->wasActionPressed("Quit")) requestStop();
            if (m_platform->wasActionPressed("Overlay")) m_overlay.toggle();
            world().registry().get<Pulse>(m_pulse).speed = m_platform->isActionDown("Faster") ? 6.0f : 1.5f;
        }

        void onRender() override {
            const mge::GpuFrame* frame = m_gpu->frame();
            if (!frame) return; // Ventana minimizada: no hay imagen este frame

            const float phase = world().registry().get<Pulse>(m_pulse).phase;
            mge::ColorTarget target;
            target.texture = frame->swapchain;
            target.clearColor = {0.5f + 0.4f * std::sin(phase), 0.25f, 0.5f + 0.4f * std::cos(phase), 1.0f};
            {
                mge::RenderPass pass = frame->cmd->beginRenderPass(target); // Limpia la imagen
                // Para dibujar mallas: mge::MeshRenderer (src/mge/graphics/README.md)
            } // El pass se cierra al salir del bloque

            // Encima: texto y overlay (píxeles lógicos, origen arriba a la izquierda; escala entera = nítido)
            m_overlay.addFrame(time().unscaledDelta() * 1000.0f, frame->acquireMs);
            m_ui->begin(frame->width, frame->height, std::max(1.0f, std::round(frame->displayScale)));
            m_ui->text({16.0f, m_ui->size().y - 40.0f}, "@GAME_TITLE@", {1.0f, 1.0f, 1.0f, 1.0f}, 3.0f);
            m_overlay.draw(*m_ui);
            m_ui->flush(*frame->cmd, frame->swapchain);
        }

    private:
        static mge::ApplicationConfig makeConfig() {
            mge::ApplicationConfig config;
            config.title = "@GAME_TITLE@";
            config.width = 1280;
            config.height = 720;
            return config;
        }

        mge::PlatformModule* m_platform = nullptr;
        mge::GpuModule* m_gpu = nullptr;
        mge::Entity m_pulse;
        std::unique_ptr<mge::Renderer2D> m_ui;
        mge::DebugOverlay m_overlay; // F1
    };
}

mge::Application* mge::createApplication() {
    return new @GAME_CLASS@();
}
