#include "logic.h"

#include <stdio.h>

#define TEST_ASSERT(cond)                                                                                    \
    do {                                                                                                     \
        if (!(cond)) {                                                                                       \
            fprintf(stderr, "FALLO en %s:%d: %s\n", __FILE__, __LINE__, #cond);                              \
            return 1;                                                                                        \
        }                                                                                                    \
    } while (0)

#define TEST_ASSERT_FLOAT_EQ(a, b, eps)                                                                      \
    do {                                                                                                     \
        float diff = (a) - (b);                                                                              \
        if (diff < 0) diff = -diff;                                                                          \
        if (diff > (eps)) {                                                                                  \
            fprintf(stderr, "FALLO en %s:%d: %f != %f (eps %f)\n", __FILE__, __LINE__, (float)(a), (float)(b), (float)(eps)); \
            return 1;                                                                                        \
        }                                                                                                    \
    } while (0)

static int test_player_init(void) {
    GameLogicState state;
    game_logic_init(&state);
    TEST_ASSERT(state.player.grounded == true);
    TEST_ASSERT_FLOAT_EQ(state.player.y, 0.0f, 0.001f);
    TEST_ASSERT_FLOAT_EQ(state.player.vy, 0.0f, 0.001f);
    return 0;
}

static int test_player_jump(void) {
    GameLogicState state;
    game_logic_init(&state);

    /* Iniciar salto */
    game_logic_update(&state, 0.016f, true);
    TEST_ASSERT(state.player.grounded == false);
    TEST_ASSERT(state.player.vy > 0.0f);
    TEST_ASSERT(state.player.y > 0.0f);

    /* Simular hasta caer de nuevo al suelo */
    for (int i = 0; i < 100; ++i) {
        game_logic_update(&state, 0.016f, false);
    }
    TEST_ASSERT(state.player.grounded == true);
    TEST_ASSERT_FLOAT_EQ(state.player.y, 0.0f, 0.001f);
    return 0;
}

int main(void) {
    printf("Ejecutando tests de @GAME_NAME@ (C 3D)...\n");
    if (test_player_init() != 0) return 1;
    if (test_player_jump() != 0) return 1;
    printf("Todos los tests de @GAME_NAME@ pasaron con exito.\n");
    return 0;
}
