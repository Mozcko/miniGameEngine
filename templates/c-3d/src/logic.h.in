#ifndef @GAME_NAME@_LOGIC_H
#define @GAME_NAME@_LOGIC_H

#include <stdbool.h>

/* Player and 3D scene state */
typedef struct GamePlayer {
    float x;
    float y;
    float z;
    float vy;
    bool grounded;
} GamePlayer;

typedef struct GameLogicState {
    GamePlayer player;
    float rotationY;
    int score;
} GameLogicState;

/* Initializes the initial game state */
void game_logic_init(GameLogicState* state);

/* Updates basic physics and rotation on a fixed or variable step */
void game_logic_update(GameLogicState* state, float dt, bool wantJump);

#endif /* @GAME_NAME@_LOGIC_H */
