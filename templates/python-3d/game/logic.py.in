"""Decoupled game logic for @GAME_TITLE@."""
from dataclasses import dataclass


@dataclass
class PlayerState:
    x: float = 0.0
    y: float = 0.0
    z: float = 0.0
    vy: float = 0.0
    grounded: bool = True


class GameLogic:
    def __init__(self) -> None:
        # Initial player state and scene rotation
        self.player = PlayerState()
        self.rotation_y: float = 0.0
        self.gravity: float = -9.8
        self.jump_speed: float = 5.0

    def update(self, dt: float, want_jump: bool = False) -> None:
        # Simplified physics: vertical impulse and gravity
        if want_jump and self.player.grounded:
            self.player.vy = self.jump_speed
            self.player.grounded = False

        if not self.player.grounded:
            self.player.vy += self.gravity * dt
            self.player.y += self.player.vy * dt

            # Basic collision with the ground plane at y = 0
            if self.player.y <= 0.0:
                self.player.y = 0.0
                self.player.vy = 0.0
                self.player.grounded = True

        # Continuous rotation of the central cube
        self.rotation_y += dt * 1.5
