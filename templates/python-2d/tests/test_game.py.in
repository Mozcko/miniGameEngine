"""Tests unitarios para la logica de @GAME_TITLE@ (Python 2D)."""
from game.logic import GameLogic2D, Rect


def test_rect_intersection() -> None:
    r1 = Rect(0.0, 0.0, 10.0, 10.0)
    r2 = Rect(5.0, 5.0, 10.0, 10.0)
    r3 = Rect(20.0, 20.0, 10.0, 10.0)
    assert r1.intersects(r2) is True
    assert r1.intersects(r3) is False


def test_player_movement_and_clamping() -> None:
    logic = GameLogic2D(800.0, 600.0)
    initial_x = logic.player_rect.x
    # Mover a la derecha
    logic.update(0.1, move_x=1.0, move_y=0.0)
    assert logic.player_rect.x > initial_x

    # Intentar moverse fuera de la pantalla
    for _ in range(100):
        logic.update(0.1, move_x=1.0, move_y=0.0)
    assert logic.player_rect.x <= 800.0 - logic.player_rect.w


def test_coin_collection() -> None:
    logic = GameLogic2D(800.0, 600.0)
    # Colocar jugador sobre la primera moneda
    coin0 = logic.coins[0]
    logic.player_rect.x = coin0.x
    logic.player_rect.y = coin0.y

    initial_count = len(logic.coins)
    collected = logic.update(0.016, move_x=0.0, move_y=0.0)
    assert collected == 1
    assert logic.score == 10
    assert len(logic.coins) == initial_count - 1
