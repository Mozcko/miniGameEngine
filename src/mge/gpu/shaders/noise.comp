#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Reglas de binding SDL3 GPU para compute (SPIR-V):
// Set 0: texturas y buffers de solo lectura (storage buffers)
layout(set = 0, binding = 0, std430) readonly buffer PermutationBuffer {
    uint u_perm[256];
};

// Set 1: texturas y buffers de lectura/escritura (storage buffers)
layout(set = 1, binding = 0, std430) buffer DensityBuffer {
    float u_density[];
};

// Set 2: uniform buffers (std140)
layout(set = 2, binding = 0, std140) uniform Params {
    vec3 u_origin;
    float _pad0;
    vec3 u_scale;
    float _pad1;
    uint u_width;
    uint u_height;
    uint u_depth;
    int u_octaves;
    float u_frequency;
    float u_lacunarity;
    float u_gain;
    float _pad2;
};

// 12 aristas del cubo para simplex 3D (igual a mge::Noise en Noise.cpp)
const vec3 kGrad3[12] = vec3[12](
    vec3(1.0, 1.0, 0.0), vec3(-1.0, 1.0, 0.0), vec3(1.0, -1.0, 0.0), vec3(-1.0, -1.0, 0.0),
    vec3(1.0, 0.0, 1.0), vec3(-1.0, 0.0, 1.0), vec3(1.0, 0.0, -1.0), vec3(-1.0, 0.0, -1.0),
    vec3(0.0, 1.0, 1.0), vec3(0.0, -1.0, 1.0), vec3(0.0, 1.0, -1.0), vec3(0.0, -1.0, -1.0)
);

int hash1(int x) {
    return int(u_perm[x & 255]);
}

int hash2(int x, int y) {
    return hash1(x + hash1(y));
}

int hash3(int x, int y, int z) {
    return hash1(x + hash1(y + hash1(z)));
}

float simplexContrib(vec3 d, int gi) {
    float falloff = 0.6 - dot(d, d);
    if (falloff < 0.0) return 0.0;
    falloff *= falloff;
    return falloff * falloff * dot(kGrad3[gi % 12], d);
}

float simplex3D(float x, float y, float z) {
    const float kF3 = 1.0 / 3.0;
    const float kG3 = 1.0 / 6.0;
    float s = (x + y + z) * kF3;
    int i = int(floor(x + s));
    int j = int(floor(y + s));
    int k = int(floor(z + s));
    float t = float(i + j + k) * kG3;
    vec3 p0 = vec3(x - (float(i) - t), y - (float(j) - t), z - (float(k) - t));

    ivec3 o1;
    ivec3 o2;
    if (p0.x >= p0.y) {
        if (p0.y >= p0.z) {
            o1 = ivec3(1, 0, 0);
            o2 = ivec3(1, 1, 0);
        } else if (p0.x >= p0.z) {
            o1 = ivec3(1, 0, 0);
            o2 = ivec3(1, 0, 1);
        } else {
            o1 = ivec3(0, 0, 1);
            o2 = ivec3(1, 0, 1);
        }
    } else {
        if (p0.y < p0.z) {
            o1 = ivec3(0, 0, 1);
            o2 = ivec3(0, 1, 1);
        } else if (p0.x < p0.z) {
            o1 = ivec3(0, 1, 0);
            o2 = ivec3(0, 1, 1);
        } else {
            o1 = ivec3(0, 1, 0);
            o2 = ivec3(1, 1, 0);
        }
    }

    vec3 p1 = p0 - vec3(o1) + kG3;
    vec3 p2 = p0 - vec3(o2) + 2.0 * kG3;
    vec3 p3 = p0 - 1.0 + 3.0 * kG3;

    float n = simplexContrib(p0, hash3(i, j, k)) +
              simplexContrib(p1, hash3(i + o1.x, j + o1.y, k + o1.z)) +
              simplexContrib(p2, hash3(i + o2.x, j + o2.y, k + o2.z)) +
              simplexContrib(p3, hash3(i + 1, j + 1, k + 1));
    return clamp(32.0 * n, -1.0, 1.0);
}

float octaveOffset(int octave) {
    return float(octave) * 17.31;
}

float fbmSimplex(float x, float y, float z) {
    float sum = 0.0;
    float amplitude = 1.0;
    float norm = 0.0;
    float frequency = u_frequency;
    int oct = max(u_octaves, 1);
    for (int o = 0; o < oct; ++o) {
        sum += simplex3D(x * frequency + octaveOffset(o), y * frequency, z * frequency) * amplitude;
        norm += amplitude;
        amplitude *= u_gain;
        frequency *= u_lacunarity;
    }
    return norm > 0.0 ? sum / norm : 0.0;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;
    if (x >= u_width || y >= u_height || z >= u_depth) {
        return;
    }

    vec3 worldPos = u_origin + vec3(float(x), float(y), float(z)) * u_scale;
    float val = fbmSimplex(worldPos.x, worldPos.y, worldPos.z);
    uint idx = x + y * u_width + z * (u_width * u_height);
    u_density[idx] = val;
}
