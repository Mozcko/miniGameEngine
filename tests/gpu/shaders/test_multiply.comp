#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Reglas de binding SDL3 GPU para SPIR-V en compute:
// Set 1: read-write storage textures y buffers
layout(set = 1, binding = 0, std430) buffer OutputBuffer {
    uint values[];
};

// Set 2: uniform buffers
layout(set = 2, binding = 0, std140) uniform Params {
    uint multiplier;
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < 1024u) {
        values[index] = index * multiplier;
    }
}
